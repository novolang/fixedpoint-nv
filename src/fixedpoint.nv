pub fn format_q1_15(x: FxQ1_15, places: Int) -> Str
    todo("fixedpoint.format_q1_15")

// Decimal digits as a Q1.15's stored integer.
pub fn parse_q1_15(s: Str) -> Result<Int, FxError>
    todo("fixedpoint.parse_q1_15")

