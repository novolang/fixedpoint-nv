// ── Describing a format ─────────────────────────────────────────────

// The name a format prints under: `Q16.16`, `UQ16.16`, `Q1.15`.
//
// What an error message and a register dump both want, and the reason
// it takes the three numbers rather than a type: a caller using a
// format this package does not ship gets the same spelling.
//
// ```novo
// use fixedpoint
//
// fn main() [io]
//     println(fixedpoint.format_name(16, 32, true))   // Q16.16
// ```
pub fn format_name(frac_bits: Int, total_bits: Int, signed: Bool) -> Str
    todo("fixedpoint.format_name")
