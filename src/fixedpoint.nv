pub fn parse_q8_24(s: Str) -> Result<Int, FxError>
    todo("fixedpoint.parse_q8_24")

// A UQ16.16 as decimal digits.
pub fn format_uq16_16(x: FxUQ16_16, places: Int) -> Str
    todo("fixedpoint.format_uq16_16")

// Decimal digits as a UQ16.16's stored integer.  A leading `-` is
